// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["users", "media", "posts", "chats", "engagements"]
}

// ---------------------------------------
// User, Follow, and Media Models
// ---------------------------------------

model User {
  id        String   @id @default(cuid()) @map("id")
  clerkId   String   @unique @map("clerk_id")
  email     String   @unique
  fullName  String   @map("full_name")
  avatarUrl String   @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Optional fields (General user information)
  bio       String?
  location  String?
  work      String?
  education String?
  birthday  DateTime?

  // Social Graph/Connections (Followers/Following)
  followers Follow[] @relation("follower")
  following Follow[] @relation("following")

  // Content
  media    Media[]   @relation("uploadedBy")
  posts    Post[]    @relation("posts")
  comments Comment[] @relation("comments")
  stories  Story[]   @relation("stories")
  likes    Like[]    @relation("likes")
  messages Message[] @relation("messages")

  // Conversations
  conversations ConversationParticipant[] @relation("ConversationParticipant")

  @@map("users")
  @@schema("users")
}

model Follow {
  id          String @id @default(cuid())
  followerId  String @map("follower_id")
  followingId String @map("following_id")

  // Relations
  follower  User @relation("follower", fields: [followerId], references: [id])
  following User @relation("following", fields: [followingId], references: [id])

  // Constraints
  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
  @@schema("users")
}

enum MediaType {
  IMAGE
  VIDEO

  @@map("media_type")
  @@schema("media")
}

enum MediaStatus {
  PENDING
  FAILED
  READY

  @@map("media_status")
  @@schema("media")
}

model Media {
  // Necessary fields for media management 
  id       String    @id @default(cuid())
  fileId   String    @unique @map("file_id")
  filePath String    @map("file_path")
  url      String
  type     MediaType

  // Optional fields for media metadata
  width     Int?
  height    Int?
  sizeBytes Int?        @map("size_bytes")
  duration  Int?        @map("duration")
  createdAt DateTime    @default(now()) @map("created_at")
  status    MediaStatus @default(PENDING)

  // Relations 
  uploadedById String    @map("uploaded_by_id")
  uploadedBy   User      @relation("uploadedBy", fields: [uploadedById], references: [id])
  posts        Post[]    @relation("uploadedMedia")
  stories      Story[]   @relation("storyMedia")
  messages     Message[] @relation("messageMedia")

  @@map("media")
  @@schema("media")
}

// ---------------------------------------
// Post, Comment, Story, and Like Models
// ---------------------------------------
model Post {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  content   String
  createdAt DateTime  @default(now()) @map("created_at")
  mediaId   String?   @map("media_id")
  deletedAt DateTime? @map("deleted_at") // Soft delete timestamp (to handle post deletions in case of shared posts)

  // Share 
  sharedPostId String? @map("shared_post_id")

  // Relations
  author User   @relation("posts", fields: [userId], references: [id])
  media  Media? @relation("uploadedMedia", fields: [mediaId], references: [id])

  // Self-referential relation for shared posts
  sharedPost Post?  @relation("shares", fields: [sharedPostId], references: [id])
  shares     Post[] @relation("shares")

  // Comments
  comments Comment[] @relation("comments")

  // Constraints
  // @@index([userId, createdAt]) // For efficient Profile Feed queries

  @@map("posts")
  @@schema("posts")
}

model Comment {
  id              String   @id @default(cuid())
  postId          String   @map("post_id")
  userId          String   @map("user_id")
  parentCommentId String?  @map("parent_comment_id")
  content         String
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  post          Post      @relation("comments", fields: [postId], references: [id])
  author        User      @relation("comments", fields: [userId], references: [id])
  parentComment Comment?  @relation("commentReplies", fields: [parentCommentId], references: [id])
  replies       Comment[] @relation("commentReplies")

  // Constraints
  // @@index([postId, createdAt]) // For efficient comment retrieval for a post


  @@map("comments")
  @@schema("posts")
}

model Story {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  content    String
  mediaId    String?  @map("media_id")
  background String? // Optional background color for text-based stories
  createdAt  DateTime @default(now()) @map("created_at")
  expiredAt  DateTime @map("expired_at")

  // Relations
  author User   @relation("stories", fields: [userId], references: [id])
  media  Media? @relation("storyMedia", fields: [mediaId], references: [id])

  // Constraints
  //@@index([userId, createdAt]) // For efficient Story Feed queries

  @@map("stories")
  @@schema("posts")
}

enum LikeableType {
  POST
  COMMENT
  STORY
  MESSAGE

  @@map("likeable_type")
  @@schema("engagements")
}

model Like {
  id         String       @id @default(cuid())
  userId     String       @map("user_id")
  TargetType LikeableType @map("target_type")
  targetId   String       @map("target_id") // Not FK -- Polymorphic relation, so This Could be Id of Post, Comment, Story, or Message
  createdAt  DateTime     @default(now()) @map("created_at")

  // Relations
  user User @relation("likes", fields: [userId], references: [id])

  // Constraints
  // @@unique([userId, TargetType, targetId])
  // @@index([TargetType, targetId]) // For efficient like count queries on posts, comments, stories, and messages

  @@map("likes")
  @@schema("engagements")
}

// ---------------------------------------
// Chat and Messaging Models
// ---------------------------------------

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  participants ConversationParticipant[] @relation("ConversationParticipant")
  messages     Message[]                 @relation("messages")

  @@map("conversations")
  @@schema("chats")
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  userId         String   @map("user_id")
  joinedAt       DateTime @default(now()) @map("joined_at")

  // Relations
  conversation Conversation @relation("ConversationParticipant", fields: [conversationId], references: [id])
  user         User         @relation("ConversationParticipant", fields: [userId], references: [id])

  // Constraints
  @@unique([conversationId, userId])


  @@map("conversation_participants")
  @@schema("chats")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id")
  content        String
  mediaId        String?  @map("media_id")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  conversation Conversation @relation("messages", fields: [conversationId], references: [id])
  sender       User         @relation("messages", fields: [senderId], references: [id])
  media        Media?       @relation("messageMedia", fields: [mediaId], references: [id])

  // Constraints
  // @@index([conversationId, createdAt]) // For efficient message retrieval for a conversation
  

  @@map("messages")
  @@schema("chats")
}
