{
  "name": "kinlo",
  "version": "1.0.0",
  "description": "**Connect. Share. Belong.** ---",
  "main": "index.js",
  "private": true,
  "directories": {
    "doc": "docs"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=apps/server",
    "dev:client": "npm run dev --workspace=apps/client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "npm run build --workspace=apps/server && npm run build --workspace=apps/client",
    "lint": "npm run lint --workspace=apps/server && npm run lint --workspace=apps/client",
    "test": "npm run test --workspace=apps/server && npm run test --workspace=apps/client"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Grintaking19/kinlo.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Grintaking19/kinlo/issues"
  },
  "homepage": "https://github.com/Grintaking19/kinlo#readme",
  "dependencies": {
    "@clerk/clerk-react": "^5.61.9"
  },
  "devDependencies": {
    "eslint": "^10.13.0"
  }
}
